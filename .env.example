# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Backend (FastAPI) ---
ENVIRONMENT=development
SUPABASE_URL=
# Service role key bypasses RLS -- backend-only, NEVER shipped to the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Flutter) ---
# The anon key is safe to embed in the client by design -- it relies on
# Row Level Security (not secrecy) for protection. Set this in
# frontend/.env (a separate file, see frontend/README.md).
SUPABASE_ANON_KEY=
