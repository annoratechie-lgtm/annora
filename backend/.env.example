# "development" skips token checks (local only!). Use "staging" or "production" when hosted.
ENVIRONMENT=development

# Extra frontend origins allowed by CORS, comma-separated (e.g. the dev Vercel URL)
ALLOWED_ORIGINS=
# Optional regex of extra allowed origins (e.g. all Vercel preview URLs)
ALLOWED_ORIGIN_REGEX=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# xAI / Grok (never commit the real key)
LLM_API_KEY=
LLM_MODEL=grok-4.5
LLM_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_SECONDS=90
